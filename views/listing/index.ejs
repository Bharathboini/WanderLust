<% layout('/layouts/boilerplate') -%>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">Explore stays</h1>
            <p class="text-secondary mb-0">Find a place for your next trip.</p>
        </div>
        <% if (currentUser) {
             %><a class="btn btn-dark rounded-pill" href="/listings/new">+ Add a listing</a>
        <% } %>
    </div>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
        <% for (const listing of allListings) { %>
            <div class="col"><a class="listing-link" href="/listings/<%= listing._id %>">
                    <article class="card stay-card h-100"><img
                            src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b' %>"
                            class="card-img-top" alt="<%= listing.title %>">
                        <div class="card-body px-0">
                            <h2 class="h6 mb-1">
                                <%= listing.title %>
                            </h2>
                            <p class="small text-secondary mb-1">
                                <%= listing.location %>, <%= listing.country %>
                            </p>
                            <p class="mb-0"><strong>₹<%= listing.price.toLocaleString('en-IN') %></strong> <span
                                    class="text-secondary">night</span></p>
                        </div>
                    </article>
                </a></div>
        <% } %>
    </div>
    <% if (!allListings.length) { %>
        <div class="alert alert-light">No stays yet. Sign in to add the first one.</div>
    <% } %>