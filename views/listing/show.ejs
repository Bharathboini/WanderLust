<% layout('/layouts/boilerplate') -%>
<div class="row justify-content-center">
<div class="col-lg-9"><img class="detail-image rounded-4 mb-4" src="<%= singleListing.image?.url %>"
alt="<%= singleListing.title %>">
<div class="d-flex justify-content-between align-items-start">
<div>
<h1 class="h2">
    <%= singleListing.title %>
</h1>
<p class="text-secondary">
    <%= singleListing.location %>, <%= singleListing.country %> · Hosted by <%=
                singleListing.owner?.username || 'Wanderlust host' %>
</p>
</div>
<!--  New reference explicitly comparing structural IDs -->
<% if (currentUser && singleListing.owner && String(currentUser._id)===String(singleListing.owner._id))
{ %>


<div class="d-flex gap-2"><a class="btn btn-outline-dark"
        href="/listings/<%= singleListing._id %>/edit">Edit</a>
    <form method="post" action="/listings/<%= singleListing._id %>?_method=DELETE"
        onsubmit="return confirm('Delete this listing?')"><button
            class="btn btn-outline-danger">Delete</button></form>
</div>
<% } %>
</div>
<p>
<%= singleListing.description %>
</p>
<h3 class="h5">₹<%= singleListing.price.toLocaleString('en-IN') %> <small
    class="text-secondary fw-normal">per night</small></h3>
<hr>
<h2 class="h4">Reviews</h2>
<% if (currentUser) { %>
<form class="card card-body mb-4" method="post" action="/listings/<%= singleListing._id %>/reviews">
<label class="form-label" for="rating">Your rating</label><select id="rating"
    class="form-select mb-3" name="review[rating]" required>
    <option value="">Choose a rating</option>
    <% for(let i=5;i>=1;i--){ %><option value="<%= i %>">
            <%= i %> stars
        </option>
        <% } %>
</select><label class="form-label" for="comment">Your review</label><textarea id="comment"
    class="form-control mb-3" name="review[comment]" required></textarea><button
    class="btn btn-dark align-self-start">Submit review</button>
</form>
<% } else { %>
<p><a href="/login">Sign in</a> to leave a review.</p>
<% } %>
    <div class="row g-3">
        <% for(const review of singleListing.reviews){ %>
            <div class="col-md-6">
                <article class="card h-100">
                    <div class="card-body"><strong>
                            <%= review.author?.username || 'Guest' %>
                        </strong>
                        <div class="text-warning">
                            <%= '★' .repeat(review.rating) %>
                                <%= '☆' .repeat(5-review.rating) %>
                        </div>
                        <p class="mb-2 mt-2">
                            <%= review.comment %>
                        </p>
                        <% if(currentUser && review.author &&
                            String(currentUser._id)===String(review.author._id)){ %>
                            <form method="post"
                                action="/listings/<%= singleListing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                <button class="btn btn-link btn-sm text-danger p-0">Delete
                                    review</button>
                            </form>
                            <% } %>
                    </div>
                </article>
            </div>
            <% } %>
    </div>
</div>
</div>