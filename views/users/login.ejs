<% layout('/layouts/boilerplate') -%>
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <h1 class="h2 mb-4">Welcome back</h1>
            <form method="post" action="/login"><label class="form-label" for="username">Username</label><input
                    id="username" class="form-control mb-3" name="username" required autocomplete="username"><label
                    class="form-label" for="password">Password</label><input id="password" type="password"
                    class="form-control mb-4" name="password" required autocomplete="current-password"><button
                    class="btn btn-dark rounded-pill w-100">Log in</button></form>
            <p class="mt-3">New to Wanderlust? <a href="/register">Create an account</a></p>
        </div>
    </div>