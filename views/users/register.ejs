<% layout('/layouts/boilerplate') -%>
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <h1 class="h2 mb-4">Create your account</h1>
            <form method="post" action="/register"><label class="form-label" for="username">Username</label><input
                    id="username" class="form-control mb-3" name="username" required minlength="3"
                    autocomplete="username"><label class="form-label" for="email">Email</label><input id="email"
                    type="email" class="form-control mb-3" name="email" required autocomplete="email"><label
                    class="form-label" for="password">Password</label><input id="password" type="password"
                    class="form-control mb-4" name="password" required minlength="8" autocomplete="new-password"><button
                    class="btn btn-danger rounded-pill w-100">Sign up</button></form>
            <p class="mt-3">Already registered? <a href="/login">Log in</a></p>
        </div>
    </div>